{
  "rules": {
    "leaderboard": {
      ".read": true,
      ".indexOn": [
        "score"
      ],
      "$uid": {
        ".write": "!data.exists() || newData.child('score').val() >= data.child('score').val()",
        ".validate": "newData.hasChildren(['name','score','level','ts']) && newData.child('name').isString() && newData.child('name').val().length >= 2 && newData.child('name').val().length <= 16 && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() < 100000000 && newData.child('level').isNumber() && $uid.length <= 40"
      }
    },
    "stats": {
      ".read": true,
      "$level": {
        ".validate": "$level.matches(/^[0-9]{1,5}$/)",
        "tried": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        },
        "won": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        },
        "fails": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        },
        "easy": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        },
        "mid": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        },
        "hard": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}